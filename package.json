{
  "name": "pantry-pal",
  "version": "0.10.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack && node scripts/build-pwa.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc -p workers/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "cap:sync": "next build && cap sync",
    "cap:ios": "next build && cap sync ios && cap open ios",
    "cap:android": "next build && cap sync android && cap open android",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test:workers": "vitest run --config workers/api/vitest.config.ts",
    "cf:types": "wrangler types worker-configuration.d.ts",
    "cf:dev": "wrangler dev",
    "cf:deploy:staging": "npm run build && wrangler deploy --env staging",
    "cf:migrate:local": "node scripts/migrate-d1.mjs --env local --local",
    "cf:migrate:staging": "node scripts/migrate-d1.mjs --env staging --remote",
    "cf:migrate:production": "node scripts/migrate-d1.mjs --env production --remote",
    "test:scripts": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@zxing/browser": "^0.2.0",
    "@zxing/library": "^0.22.0",
    "better-auth": "^1.7.5",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.16.0",
    "next": "^16.3.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/ios": "^8.3.4",
    "@cloudflare/workers-types": "^5.20260920.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^5.0.1",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.1.1",
    "miniflare": "^5.20260918.0-alpha",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1",
    "wrangler": "^4.135.0"
  },
  "engines": {
    "node": ">=24"
  }
}
