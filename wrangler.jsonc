{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pantry-pal-local",
  "main": "workers/api/index.ts",
  "account_id": "51bdcee14c5264ede36f2bd6e9a3ddaa",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET"
    ]
  },
  "vars": {
    "BETTER_AUTH_URL": "http://localhost:8787",
    "AUTH_EMAIL_FROM": "accounts@pantry.ainadara.com",
    "AUTH_EMAIL_ENABLED": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pantry-pal-staging",
      "database_id": "5e76adb1-c413-4a50-bb4c-e98d97f258c5",
      "migrations_dir": "migrations/d1"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": [
        "accounts@pantry.ainadara.com"
      ]
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "PROVIDER_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "env": {
    "staging": {
      "name": "pantry-pal-staging",
      "workers_dev": true,
      "secrets": {
        "required": [
          "BETTER_AUTH_SECRET"
        ]
      },
      "vars": {
        "BETTER_AUTH_URL": "https://pantry-pal-staging.refinalophaina.workers.dev",
        "AUTH_EMAIL_FROM": "accounts@pantry.ainadara.com",
        "AUTH_EMAIL_ENABLED": "true"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pantry-pal-staging",
          "database_id": "5e76adb1-c413-4a50-bb4c-e98d97f258c5",
          "migrations_dir": "migrations/d1"
        }
      ],
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": [
            "accounts@pantry.ainadara.com"
          ]
        }
      ],
      "ai": {
        "binding": "AI"
      },
      "ratelimits": [
        {
          "name": "PROVIDER_LIMITER",
          "namespace_id": "1001",
          "simple": {
            "limit": 10,
            "period": 60
          }
        }
      ],
      "triggers": {
        "crons": [
          "17 * * * *"
        ]
      },
      "preview_urls": false
    },
    "production": {
      "name": "pantry-pal",
      "workers_dev": false,
      "secrets": {
        "required": [
          "BETTER_AUTH_SECRET"
        ]
      },
      "vars": {
        "BETTER_AUTH_URL": "https://pantry.ainadara.com",
        "AUTH_EMAIL_FROM": "accounts@pantry.ainadara.com",
        "AUTH_EMAIL_ENABLED": "true"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pantry-pal-production",
          "database_id": "4795b873-dc22-4f93-a6a0-feb400f80a1e",
          "migrations_dir": "migrations/d1"
        }
      ],
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": [
            "accounts@pantry.ainadara.com"
          ]
        }
      ],
      "ai": {
        "binding": "AI"
      },
      "ratelimits": [
        {
          "name": "PROVIDER_LIMITER",
          "namespace_id": "1001",
          "simple": {
            "limit": 10,
            "period": 60
          }
        }
      ],
      "triggers": {
        "crons": [
          "17 * * * *"
        ]
      },
      "preview_urls": false,
      "routes": [
        {
          "pattern": "pantry.ainadara.com/*",
          "zone_id": "2a2719a53cd0fce9c87a378b7d8bf3e0"
        }
      ]
    }
  }
}
